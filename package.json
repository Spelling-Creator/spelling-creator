{
  "name": "spelling-creator-monorepo",
  "version": "0.0.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "author": "playforge-coding",
  "type": "module",
  "scripts": {
    "dev:web": "pnpm --filter @spelling-creator/web dev",
    "dev:api": "pnpm --filter @spelling-creator/api dev",
    "dev:mcp": "pnpm --filter @spelling-creator/mcp start",
    "dev:docs": "pnpm --filter @spelling-creator/docs dev",
    "mcp:login": "pnpm --filter @spelling-creator/mcp login",
    "build": "pnpm --filter @spelling-creator/web build",
    "build:docs": "pnpm --filter @spelling-creator/docs build",
    "preview": "pnpm --filter @spelling-creator/web preview",
    "deploy": "pnpm build && pnpm build:docs && pnpm --filter @spelling-creator/api deploy",
    "test": "pnpm -r test",
    "lint": "oxfmt --check . && oxlint",
    "fmt": "oxfmt ."
  },
  "devDependencies": {
    "oxfmt": "^0.66.0",
    "oxlint": "^1.81.0"
  },
  "packageManager": "pnpm@11.25.0"
}
