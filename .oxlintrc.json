{
  "$schema": "./node_modules/oxlint/configuration_schema.json",

  "ignorePatterns": [
    "**/dist/**",
    "**/dist-ssr/**",
    "**/build/**",
    "**/node_modules/**",
    "**/.wrangler/**",
    "**/doc_build/**"
  ],

  // `eslint` + `react` mirror the previous ESLint setup (js/recommended,
  // eslint-plugin-react, eslint-plugin-react-hooks). Oxlint enables `unicorn`,
  // `oxc` and `typescript` by default; they are left off so the rule set stays
  // the one this codebase was written against.
  "plugins": ["eslint", "react"],
  "categories": {
    "correctness": "error"
  },

  "env": {
    "builtin": true
  },

  "rules": {
    // Part of ESLint's `js/recommended`, but not of oxlint's `correctness`
    // category. It's what makes the `env`/`globals` blocks below do anything.
    "eslint/no-undef": "error",
    "eslint/no-unused-vars": [
      "error",
      {
        "caughtErrors": "none",
        "argsIgnorePattern": "^_",
        "varsIgnorePattern": "^_"
      }
    ]
  },

  "overrides": [
    // Web app — React in the browser (modern JSX transform, no PropTypes)
    {
      "files": ["apps/web/**/*.js", "apps/web/**/*.jsx"],
      "env": { "browser": true },
      "rules": {
        "react-hooks/rules-of-hooks": "error",
        "react-hooks/exhaustive-deps": "warn",
        "react/set-state-in-effect": "off"
        // The ESLint config also switched off `react/prop-types` and
        // `react-hooks/set-state-in-effect`. Oxlint implements neither rule, so
        // there is nothing to disable here. If `set-state-in-effect` ever lands,
        // turn it off again: resetting local state when a dialog opens / a route
        // param changes is an intentional, well-contained pattern in this app,
        // not the cascading-render smell that rule targets.
      }
    },

    // API — Cloudflare Worker runtime
    {
      "files": ["apps/api/**/*.js"],
      "env": { "worker": true, "node": true },
      "globals": {
        // Cloudflare-specific runtime globals, used by the Durable Objects.
        // HTMLRewriter used to be here too, for the rich-text sanitizer; that now
        // parses with parse5 so it runs on any host (see lib/richtext.js).
        "WebSocketPair": "readonly",
        "WebSocketRequestResponsePair": "readonly"
      }
    },

    // MCP server — Node runtime (also uses Web-standard fetch/crypto globals)
    {
      "files": ["apps/mcp/**/*.js", "apps/mcp/**/*.mjs"],
      "env": { "node": true }
    },

    // Repo tooling — plain Node scripts run by hand, never bundled or shipped.
    {
      "files": [
        "scripts/**/*.js",
        "scripts/**/*.mjs",
        "packages/core/scripts/**/*.mjs"
      ],
      "env": { "node": true }
    },

    // ...except `views/`, which is the source of the MCP Apps views: browser code
    // that is bundled into an HTML resource and runs in the host's sandboxed
    // iframe, never in Node. Anything in the server proper that reached for the
    // DOM is still a lint error, which is the point of splitting it out.
    {
      "files": ["apps/mcp/views/**/*.js"],
      "env": { "browser": true }
    },

    // Shared core — runtime-neutral by default, so it stays importable from the
    // Worker and the MCP server as well as the browser. `worker` is the narrowest
    // env that covers the Web-standard globals it leans on (crypto, URL, Blob).
    {
      "files": ["packages/core/**/*.js"],
      "env": { "worker": true }
    },

    // ...except the tests, which only ever run under vitest on Node. Keeping this
    // to `*.test.js` means the modules themselves stay held to the runtime-neutral
    // rule above: a test may reach for `process` (to pin TZ, say), the code it
    // tests may not.
    {
      "files": ["packages/core/**/*.test.js"],
      "env": { "worker": true, "node": true }
    },

    // ...except the `browser/` tier, which is framework-agnostic but genuinely
    // needs a DOM (IndexedDB, <canvas>, FileReader, an <a> to download). It sits
    // behind the `@spelling-creator/core/browser/*` subpaths so the Worker and the
    // MCP server can't reach it by accident, and the split above means a module
    // outside this directory still fails lint the moment it touches the DOM.
    {
      "files": ["packages/core/src/browser/**/*.js"],
      "env": { "browser": true }
    }
  ]
}
