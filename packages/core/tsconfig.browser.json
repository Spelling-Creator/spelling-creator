{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["es2024", "dom", "dom.iterable"],
    // Only Vite ever loads browser/, so its imports resolve the way Vite's do,
    // `?url` suffixes and all.
    "module": "preserve",
    "moduleResolution": "bundler",
    "tsBuildInfoFile": "node_modules/.cache/tsc/browser.tsbuildinfo"
  },
  // All of src, not just browser/: a project has to list every file it checks,
  // and browser/ imports the shared modules. Those are checked here again with
  // the DOM, which is harmless; tsconfig.shared.json is what keeps them off it.
  "include": ["src"],
  "exclude": ["src/**/*.test.*"]
}
