{
  "name": "@spelling-creator/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "imports": {
    "#image-codec-wasm": {
      "workerd": "./src/codecs/wasm.workerd.js",
      "default": "./src/codecs/wasm.node.js"
