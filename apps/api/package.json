{
	"name": "@spelling-creator/api",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"imports": {
		"#image-codec-wasm": {
			"workerd": "./src/codecs/wasm.workerd.js",
			"default": "./src/codecs/wasm.node.js"
		}
	},
	"scripts": {
		"deploy": "pnpm --filter @spelling-creator/web build:ssr && wrangler deploy",
		"dev": "pnpm --filter @spelling-creator/web build:ssr && wrangler dev",
		"start": "pnpm --filter @spelling-creator/web build:ssr && wrangler dev",
		"test": "pnpm --filter @spelling-creator/web build:ssr && vitest run",
		"bundle": "wrangler deploy --dry-run --outdir dist",
		"start:node": "node src/node/server.js"
	},
	"dependencies": {
		"@cloudflare/puppeteer": "^1.4.0",
		"@cloudflare/workers-oauth-provider": "^0.10.3",
		"@hono/node-server": "^2.1.1",
		"@jsquash/jpeg": "^1.6.0",
		"@jsquash/png": "^3.1.1",
		"@jsquash/webp": "^1.5.0",
		"@spelling-creator/core": "workspace:*",
		"@spelling-creator/mcp": "workspace:*",
		"agents": "^0.20.1",
		"glin-profanity": "^3.3.0",
		"hono": "^4.13.2",
		"parse5": "^8.0.1",
		"yjs": "^13.6.32"
	},
	"devDependencies": {
		"@cloudflare/vitest-pool-workers": "^0.12.4",
		"vitest": "~5.0.0",
		"wrangler": "^4.128.0"
	},
	"packageManager": "pnpm@11.25.0"
}
