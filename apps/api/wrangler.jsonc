{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "spelling-creator",
	"main": "src/index.js",
	"compatibility_date": "2026-05-28",
	// @cloudflare/puppeteer (used for crawler prerendering) needs the Node.js
	// compatibility runtime.
	"compatibility_flags": ["nodejs_compat"],
	"observability": {
		"enabled": true,
	},

	// Two of the MCP server's assets are imported as strings: its authoring
	// standard (apps/mcp/src/standards.md) and the built MCP Apps views
	// (apps/mcp/src/views/*.html, served as `ui://` resources). Neither .md nor
	// .html is one of the bundler's default Text globs, so both are declared here.
	"rules": [{ "type": "Text", "globs": ["**/*.md", "**/*.html"], "fallthrough": true }],

	"vars": {
		"ALLOWED_HOSTNAMES": "spellingcreator.org",
		"SUPABASE_URL": "https://hfkgrqihawgosalltjpy.supabase.co",
		// Publishable anon key (same one apps/web and apps/mcp ship) — used only for
		// the MCP OAuth route's Supabase session refresh (routes/mcp.js). Safe to
		// commit: it grants no more than the browser client already can.
		"SUPABASE_ANON_KEY": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Imhma2dycWloYXdnb3NhbGx0anB5Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODAwNzQ4NDMsImV4cCI6MjA5NTY1MDg0M30.G-Ait5_9WqUfBQLfinHiOPl3w_LwwK5jA_G_aGw97CU",
		// Self-referential base URL the MCP tool layer calls back into (routes/mcp.js).
		"SPELLING_CREATOR_API_URL": "https://spellingcreator.org",
	},

	// Serve the built web SPA as static assets. The Worker runs first on every
	// request (run_worker_first) so it can intercept crawler navigations and
	// return a prerendered snapshot; everything else falls through to env.ASSETS.
	//
	// not_found_handling is "none" — deliberately *not* "single-page-application".
	// The SPA fallback served index.html with a 200 for every path with no file
	// behind it, which resolved deep links and, in the same stroke, answered
	// /nonsense and /.well-known/anything.json with a successful HTML document.
	// Client-side (BrowserRouter) routes are still served the shell; that decision
	// now lives in src/routes/spa.js, which holds the app's route table and can
	// tell a page from a typo. Anything unrecognised gets a real 404.
	"assets": {
		"directory": "../web/dist",
		"binding": "ASSETS",
		"not_found_handling": "none",
		"run_worker_first": true,
	},

	// Browser Rendering binding — headless Chromium used to prerender pages for
	// crawlers/social scrapers via @cloudflare/puppeteer.
	"browser": {
		"binding": "BROWSER",
	},

	// Workers AI binding — the "workers-ai" AI provider (src/lib/ai/providers/workers-ai.js).
	// Unlike the other providers it needs no API key/secret, so it's always
	// configured once this binding exists; it's ordered last by default (see
	// DEFAULT_ORDER in src/lib/ai/index.js) as a no-external-dependency fallback
	// rather than competing for priority with the higher-quality hosted models.
	"ai": {
		"binding": "AI",
	},

	"kv_namespaces": [
		{
			"binding": "RATE_LIMIT_KV",
			"id": "e3d5364c3c8f4637937bb07a17ffbb38",
		},
		// Grant/token/client storage for the MCP OAuth provider (routes/mcp.js), plus
		// this Worker's own short-lived pending-authorization state (routes/oauth.js).
		// Create once with:
		//   wrangler kv namespace create OAUTH_KV
		{
			"binding": "OAUTH_KV",
			"id": "f9496452d8434755adc716c84ceb5415",
		},
	],

	// Live-collaboration coordinator. One CollabRoom Durable Object per session
	// (addressed by the host's share code) relays edits/cursors/chat over a single
	// WebSocket and enforces per-room/per-connection limits. See src/collab-room.js
	// and handleCollab in src/index.js. SQLite-backed (the room caches the doc).
	//
	// HubMcp is one remote MCP connection's tool server (routes/mcp.js), addressed
	// per-session by the Agents SDK; MCP_OBJECT is the binding name the SDK looks
	// for by default (McpAgent.serve()'s `binding` option).
	"durable_objects": {
		"bindings": [
			{ "name": "COLLAB_ROOM", "class_name": "CollabRoom" },
			{ "name": "MCP_OBJECT", "class_name": "HubMcp" },
		],
	},
	"migrations": [
		{ "tag": "v1", "new_sqlite_classes": ["CollabRoom"] },
		{ "tag": "v2", "new_sqlite_classes": ["HubMcp"] },
	],

	// R2 bucket holding lesson images as binary objects, keyed by their SHA-256
	// content hash. Served publicly by GET /images/:hash and written by the
	// authenticated PUT /images/:hash (see src/index.js). Create it once with:
	//   wrangler r2 bucket create spelling-creator-images
	"r2_buckets": [
		{
			"binding": "IMAGES",
			"bucket_name": "spelling-creator-images",
		},
		// R2 bucket holding each lesson's version history as a git packfile, under
		// git/<lessonId>/pack (+ refs.json). The editor keeps every lesson in a real
		// git repository in the browser; this is how that repository travels, so
		// forking a lesson can *clone* it. GET is public (forking a published lesson
		// is public), PUT is the author's only. See src/routes/git.js.
		// Create it once with:
		//   wrangler r2 bucket create spelling-creator-git
		{
			"binding": "LESSON_GIT",
			"bucket_name": "spelling-creator-git",
		},
	],
}
