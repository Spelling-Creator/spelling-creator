# Spelling Creator MCP server — configuration.
#
# The server publishes lessons through the same Worker endpoints the web app
# uses, authenticating as you with a Supabase token. Copy this file to `.env`
# (gitignored) or, more commonly, set these as `env` in your MCP client config
# (see README.md). Everything except the token has a sensible default.

# Base URL of the Spelling Creator Worker API. Defaults to production.
# Point at https://api.spelling-creator.localhost to target a local
# `pnpm dev:api`, with NODE_EXTRA_CA_CERTS set to the full path of
# ~/.portless/ca.pem so Node trusts its certificate.
SPELLING_CREATOR_API_URL=https://spellingcreator.org

# ---- Authentication (pick ONE) -------------------------------------------
#
# (a) A Supabase REFRESH token (recommended). Long-lived: the server trades it
#     for a fresh short-lived access token on demand and re-persists the
#     rotated refresh token, so the connection keeps working for weeks.
#     Obtain one with:  pnpm --filter @spelling-creator/mcp login
# SUPABASE_REFRESH_TOKEN=...
#
# (b) A Supabase ACCESS token (a session JWT). Simplest, but expires after
#     ~1 hour — fine for a quick session, annoying for a long-lived setup.
# SUPABASE_ACCESS_TOKEN=eyJ...

# Where the refresh helper stores its session. Defaults to
# $XDG_CONFIG_HOME/spelling-creator-mcp/session.json (or ~/.config/...).
# SPELLING_CREATOR_SESSION_FILE=

# ---- Supabase project (defaults baked in; override only for a fork) -------
# SUPABASE_URL=https://hfkgrqihawgosalltjpy.supabase.co
# SUPABASE_ANON_KEY=eyJ...
