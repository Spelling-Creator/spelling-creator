# Points the app at the local stub API (apps/stub-api) instead of a real
# backend. Used by `pnpm dev:web:stub`, which runs Vite with `--mode stub`.
# Nothing here is a secret: the stub accepts any key and any password.
#
# The three localhost:8787 URLs are for running without portless
# (PORTLESS=0). Under portless, vite.config.js replaces them with the stub's
# own portless URL.
VITE_API_URL=http://localhost:8787
VITE_SUPABASE_URL=http://localhost:8787
VITE_SUPABASE_ANON_KEY=stub
# Sign in by username or email; the stub takes any password.
VITE_AUTH_MODE=both
# Turnstile is the stub's stand-in widget, not Cloudflare's: it passes on its
# own, and the stub's AI route doesn't check the token. The site key only has
# to be non-empty for the AI dialogs to show.
VITE_TURNSTILE_SITE_KEY=stub
VITE_TURNSTILE_SCRIPT_URL=http://localhost:8787/turnstile/v0/api.js
# Left empty on purpose: Google Docs export needs a real OAuth client.
VITE_GOOGLE_CLIENT_ID=
