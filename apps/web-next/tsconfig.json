{
  "include": [
    "app/**/*",
    "scripts/**/*",
    "vite.config.ts",
    "react-router.config.ts",
    ".react-router/types/**/*"
  ],
  "compilerOptions": {
    "lib": ["es2024", "dom", "dom.iterable"],
    "types": ["node", "vite/client"],
    "target": "es2024",
    "module": "preserve",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    // React Router writes a +types file beside every route module, under
    // .react-router/types; rootDirs makes `./+types/hub` resolve from there.
    "rootDirs": [".", "./.react-router/types"],
    "paths": {
      "@/*": ["./app/*"]
    },
    "strict": true,
    "noEmit": true,
    // vite.config.ts imports the repo's portless helper, a plain .mjs file;
    // this lets tsc read its types from the file rather than treat it as any.
    "allowJs": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "skipLibCheck": true
  }
}
