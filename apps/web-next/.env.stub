# Points the app at the local stub API (apps/stub-api) instead of a real
# backend. Used by `pnpm dev:stub`, which runs the dev server with
# `--mode stub`, and by the browser tests. Nothing here is a secret: the stub
# accepts any key and any password. The same values as apps/web/.env.stub, so
# the two apps can run against one stub at once.
VITE_API_URL=http://localhost:8787
VITE_SUPABASE_URL=http://localhost:8787
VITE_SUPABASE_ANON_KEY=stub
VITE_AUTH_MODE=both
VITE_TURNSTILE_SITE_KEY=stub
VITE_GOOGLE_CLIENT_ID=
