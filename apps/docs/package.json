{
  "name": "@spelling-creator/docs",
  "version": "0.0.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "author": "playforge-coding",
  "scripts": {
    "dev": "portless run --name docs.spelling-creator sh -c 'vitepress dev docs --port ${PORT:-5173} --host ${HOST:-localhost}'",
    "start": "pnpm run dev",
    "build": "vitepress build docs",
    "copy-to-web": "node -e \"const fs=require('fs');fs.rmSync('../web/dist/docs',{recursive:true,force:true});fs.cpSync('doc_build','../web/dist/docs',{recursive:true})\"",
    "preview": "portless run --name preview.docs.spelling-creator sh -c 'vitepress preview docs --port ${PORT:-4173}'",
    "diagrams": "node scripts/diagrams.mjs"
  },
  "devDependencies": {
    "vitepress": "^2.0.0-alpha.20",
    "vitepress-plugin-llms": "^1.14.0"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.4.1"
}
